/dts-v1/;

#include <dt-bindings/soc/rockchip,vop2.h>
#include <dt-bindings/usb/pd.h>

#include "rk3568-diasom-som.dtsi"

/ {
	model = "Diasom DS-RK3568-SOM-EVB";
	compatible = "diasom,ds-rk3568-som-evb",
		     "diasom,ds-rk3568-som",
		     "rockchip,rk3568";

	aliases {
		camera1 = &imx335_i2c4;
		camera2 = &imx335_i2c7;
		camera4 = &imx415_i2c4;
		camera5 = &imx415_i2c7;
		camera6 = &imx327;
		camera7 = &ar0234;
		camera8 = &imx662;
		can0 = &can1;
		can1 = &can2;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		i2c9 = &i2c9;
		mmc1 = &sdmmc0;
		sound0 = &sound0;
	};

	chosen {
		environment-sd {
			compatible = "barebox,environment";
			device-path = &sdmmc0, "partname:env";
			status = "disabled";
		};
	};

	clk25m: clk25m {
		compatible = "fixed-clock";
		clock-frequency = <25000000>;
		#clock-cells = <0>;
	};

	clk27m: clk27m {
		compatible = "fixed-clock";
		clock-frequency = <27000000>;
		#clock-cells = <0>;
	};

	clk37m125: clk37m125 {
		compatible = "fixed-clock";
		clock-frequency = <37125000>;
		#clock-cells = <0>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm5 0 25000 0>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <256>;
		default-brightness-level = <240>;
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		label = "HDMI";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_connector_out>;
			};
		};
	};

	lvds: lvds {
		compatible = "rockchip,rk3568-lvds";
		phys = <&dsi_dphy0>;
		phy-names = "dphy";
		power-domains = <&power RK3568_PD_VO>;
		rockchip,grf = <&grf>;
		rockchip,output = "lvds";
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				lvds_in_vp2: endpoint {
					remote-endpoint = <&vp2_out_lvds>;
				};
			};

			port@1 {
				reg = <1>;

				lvds_out_panel: endpoint {
					remote-endpoint = <&lvds_in_panel>;
				};
			};
		};
	};

	lvds_panel: panel {
		pinctrl-names = "default";
		pinctrl-0 = <&lvds_pins>;
		compatible = "panel-lvds";
		backlight = <&backlight>;
		data-mapping = "jeida-24";
		enable-gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		width-mm = <210>;
		height-mm = <158>;
		status = "disabled";

		panel-timing {
			/* Raystar RFM1040G-AWW-LNN 1024x768@60 */
			clock-frequency = <65000000>;
			hactive = <1024>;
			vactive = <768>;
			hsync-len = <4>;
			hfront-porch = <100>;
			hback-porch = <216>;
			vfront-porch = <30>;
			vback-porch = <7>;
			vsync-len = <1>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <0>;
			pixelclk-active = <0>;
		};

		port {
			lvds_in_panel: endpoint {
				remote-endpoint = <&lvds_out_panel>;
			};
		};
	};

	sound0: es8388-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "ES8388";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&es8388_master>;
		simple-audio-card,frame-master = <&es8388_master>;

		es8388_master: simple-audio-card,cpu {
			sound-dai = <&i2s1_8ch>;
		};

		simple-audio-card,codec {
			sound-dai = <&es8388>;
		};
	};

	usb {
		pinctrl-names = "default";
		pinctrl-0 = <&usbmux_pins>;
		compatible = "genesys,gl9962", "gpio-sbu-mux";
		enable-gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_HIGH>;
		select-gpios = <&gpio4 RK_PD2 GPIO_ACTIVE_LOW>;
		orientation-switch;

		port {
			/* Orientation Switch */
			gpio_sbu: endpoint {
				remote-endpoint = <&typec_sbu>;
			};
		};
	};

	vcc1v8_sys: vcc1v8-sys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "1v8_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc3v3_sys>;
	};

	vcc3v3_pcie20: vcc3v3-pcie20-pwr-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "3v3_pcie20";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc3v3_sys>;
		status = "disabled";
	};

	vcc3v3_pcie30: vcc3v3-pcie30-regulator {
		pinctrl-names = "default";
		pinctrl-0 = <&pcie30_pwr_pins>;
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
		regulator-name = "3v3_pcie30";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_pi6c: vcc3v3-pi6c-regulator {
		pinctrl-names = "default";
		pinctrl-0 = <&pcie30_oe_pins>;
		compatible = "regulator-fixed";
		/* Fixup for PCI-e in the bootloader */
		regulator-always-on;
		regulator-boot-on;
		gpio = <&gpio3 RK_PD4 GPIO_ACTIVE_LOW>;
		regulator-name = "3v3_pi6c";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc3v3_pcie30>;
	};

	vcc5v0_usb3_host1: vcc5v0-usb3-host1-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "vcc5v0_usb3_host1";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc5v0_sys>;
		status = "disabled";
	};

	vcc5v0_usb3_otg0: vcc5v0-usb3-otg0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb3_otg0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc5v0_sys>;
		status = "disabled";
	};

	vcc_cam0: vcc-cam0-regulator {
		pinctrl-names = "default";
		pinctrl-0 = <&csi0_pwr>;
		compatible = "regulator-fixed";
		/* Used by RAW probe for cameras connected via I2C */
		regulator-boot-on;
		enable-active-high;
		gpio = <&gpio2 RK_PD2 GPIO_ACTIVE_HIGH>;
		regulator-name = "vcc_cam0";
		startup-delay-us = <250000>;
		status = "disabled";
	};

	vcc_cam1: vcc-cam1-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "vcc_cam1";
		startup-delay-us = <250000>;
		status = "disabled";
	};
};

&can1 {
	status = "okay";
};

&can2 {
	status = "okay";
};

&combphy1 {
	/* USB3.0 HOST1 */
	status = "okay";
};

&combphy2 {
	/* PCI-E 2.0 */
	phy-supply = <&vcc3v3_pcie20>;
	status = "okay";
};

&csi2_dphy0 {
	status = "okay";
};

&csi2_in {
	ar0234_in: endpoint@0 {
		reg = <0>;
		data-lanes = <1 2 3 4>;
		remote-endpoint = <&ar0234_out>;
	};

	imx327_in: endpoint@1 {
		reg = <1>;
		data-lanes = <1 2 3 4>;
		remote-endpoint = <&imx327_out>;
	};

	imx335_i2c4_in: endpoint@2 {
		reg = <2>;
		data-lanes = <1 2 3 4>;
		remote-endpoint = <&imx335_i2c4_out>;
	};

	imx335_i2c7_in: endpoint@3 {
		reg = <3>;
		data-lanes = <1 2>;
		remote-endpoint = <&imx335_i2c7_out>;
	};

	imx415_i2c4_in: endpoint@4 {
		reg = <4>;
		data-lanes = <1 2 3 4>;
		remote-endpoint = <&imx415_i2c4_out>;
	};

	imx415_i2c7_in: endpoint@5 {
		reg = <5>;
		data-lanes = <1 2>;
		remote-endpoint = <&imx415_i2c7_out>;
	};

	imx662_in: endpoint@6 {
		reg = <6>;
		data-lanes = <1 2 3 4>;
		remote-endpoint = <&imx662_out>;
	};
};

&csi2_dphy_hw {
	status = "okay";
};

&display_subsystem {
	status = "okay";
};

&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		pinctrl-names = "default";
		pinctrl-0 = <&dsi_pins>;
		compatible = "raystar,display-rfh1010j-ayh";
		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_LOW>;
		enable-gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		vdd-supply = <&vcc3v3_sys>;
		vccio-supply = <&vcc1v8_sys>;

		port {
			dsi_in_panel: endpoint {
				remote-endpoint = <&dsi_out_panel>;
			};
		};
	};
};

&dsi_dphy0 {
	status = "okay";
};

&dsi0_in {
	dsi0_in_vp1: endpoint {
		remote-endpoint = <&vp1_out_dsi0>;
	};
};

&dsi0_out {
	dsi_out_panel: endpoint {
		remote-endpoint = <&dsi_in_panel>;
	};
};

&gmac0 {
	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;
	pinctrl-names = "default";
	pinctrl-0 = <
		&gmac0_miim &gmac0_tx_bus2 &gmac0_rx_bus2
		&gmac0_rgmii_clk &gmac0_rgmii_bus
	>;
	clock_in_out = "output";
	phy-handle = <&rgmii_phy0>;
	phy-mode = "rgmii-id";
	phy-supply = <&vcc3v3_sys>;
};

&gmac1 {
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;
	pinctrl-names = "default";
	pinctrl-0 = <
		&gmac1m1_miim &gmac1m1_tx_bus2 &gmac1m1_rx_bus2
		&gmac1m1_rgmii_clk &gmac1m1_rgmii_bus
	>;
	clock_in_out = "output";
	phy-handle = <&rgmii_phy1>;
	phy-mode = "rgmii-id";
	phy-supply = <&vcc3v3_sys>;
};

&gpu {
	status = "okay";
};

&hdmi {
	status = "okay";
};

&hdmi_in {
	hdmi_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi>;
	};
};

&hdmi_out {
	hdmi_connector_out: endpoint {
		remote-endpoint = <&hdmi_connector_in>;
	};
};

&hdmi_sound {
	status = "okay";
};

&i2c1 {
	/* FUSB302 is not detected at 1MHz, so lets reduce frequency to 400KHz */
	clock-frequency = <400000>;
	status = "okay";

	fusb: usb@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		vbus-supply = <&vcc5v0_usb3_otg0>;
		status = "disabled";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "source";
			pd-revision = /bits/ 8 <0x2 0x0 0x1 0x2>;
			op-sink-microwatt = <10>;
			sink-pdos = <PDO_FIXED(5000, 10, PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;
			source-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					/* HS */
					reg = <0>;

					typec_hs: endpoint {
						remote-endpoint = <&usb_host0_xhci_hs>;
					};
				};

				port@1 {
					/* SS */
					reg = <1>;

					typec_ss: endpoint {
						remote-endpoint = <&usb_host0_xhci_ss>;
					};
				};

				port@2 {
					/* Orientation Switch */
					reg = <2>;

					typec_sbu: endpoint {
						remote-endpoint = <&gpio_sbu>;
					};
				};
			};
		};

		port {
			/* Role Switch */
			fusb_role_sw: endpoint {
				remote-endpoint = <&usb_host0_xhci_role_sw>;
			};
		};
	};
};

&i2c4 {
	clock-frequency = <100000>;
	status = "okay";

	es8388: codec@10 {
		compatible = "everest,es8388";
		assigned-clocks = <&cru I2S1_MCLKOUT_TX>;
		assigned-clock-rates = <12288000>;
		assigned-clock-parents = <&cru CLK_I2S1_8CH_TX>;
		reg = <0x10>;
		clocks = <&cru I2S1_MCLKOUT_TX>;
		DVDD-supply = <&vcc1v8_sys>;
		AVDD-supply = <&vcc3v3_sys>;
		PVDD-supply = <&vcc3v3_sys>;
		HPVDD-supply = <&vcc3v3_sys>;

		#sound-dai-cells = <0>;
	};

	ar0234: camera@18 {
		compatible = "onnn,ar0234cs";
		reg = <0x18>;
		clocks = <&clk27m>;
		power-domains = <&power RK3568_PD_VI>;
		vaa-supply = <&vcc_cam0>;
		vdd-supply = <&vcc_cam0>;
		vddio-supply = <&vcc_cam0>;
		status = "disabled";

		port {
			ar0234_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&ar0234_in>;
				link-frequencies = /bits/ 64 <360000000 450000000>;
			};
		};
	};

	imx327: camera-0@1a {
		compatible = "sony,imx327lqr";
		reg = <0x1a>;
		clocks = <&clk37m125>;
		clock-names = "xclk";
		power-domains = <&power RK3568_PD_VI>;
		vdda-supply = <&vcc_cam0>;
		vddd-supply = <&vcc_cam0>;
		vdddo-supply = <&vcc_cam0>;
		status = "disabled";

		port {
			imx327_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&imx327_in>;
				link-frequencies = /bits/ 64 <222750000 148500000>;
			};
		};
	};

	imx335_i2c4: camera-1@1a {
		compatible = "sony,imx335";
		reg = <0x1a>;
		clocks = <&xin24m>;
		power-domains = <&power RK3568_PD_VI>;
		avdd-supply = <&vcc_cam0>;
		dvdd-supply = <&vcc_cam0>;
		ovdd-supply = <&vcc_cam0>;
		status = "disabled";

		port {
			imx335_i2c4_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&imx335_i2c4_in>;
				link-frequencies = /bits/ 64 <594000000>;
			};
		};
	};

	imx415_i2c4: camera-2@1a {
		compatible = "sony,imx415";
		reg = <0x1a>;
		clocks = <&clk37m125>;
		clock-names = "inck";
		power-domains = <&power RK3568_PD_VI>;
		avdd-supply = <&vcc_cam0>;
		dvdd-supply = <&vcc_cam0>;
		ovdd-supply = <&vcc_cam0>;
		status = "disabled";

		port {
			imx415_i2c4_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&imx415_i2c4_in>;
				link-frequencies = /bits/ 64 <445500000>;
			};
		};
	};

	imx662: camera-3@1a {
		compatible = "sony,imx662aaqr";
		reg = <0x1a>;
		clocks = <&xin24m>;
		power-domains = <&power RK3568_PD_VI>;
		avdd-supply = <&vcc_cam0>;
		dvdd-supply = <&vcc_cam0>;
		ovdd-supply = <&vcc_cam0>;
		status = "disabled";

		port {
			imx662_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&imx662_in>;
				link-frequencies = /bits/ 64 <360000000>;
			};
		};
	};

	i2c_mux: i2c-mux@70 {
		compatible = "nxp,pca9546";
		reg = <0x70>;
		i2c-mux-idle-disconnect;
		vdd-supply = <&vcc3v3_sys>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";

		i2c6: i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c7: i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			imx335_i2c7: camera-0@1a {
				compatible = "sony,imx335";
				reg = <0x1a>;
				clocks = <&xin24m>;
				power-domains = <&power RK3568_PD_VI>;
				avdd-supply = <&vcc_cam0>;
				dvdd-supply = <&vcc_cam0>;
				ovdd-supply = <&vcc_cam0>;
				status = "disabled";

				port {
					imx335_i2c7_out: endpoint {
						data-lanes = <1 2>;
						remote-endpoint = <&imx335_i2c7_in>;
						link-frequencies = /bits/ 64 <594000000>;
					};
				};
			};

			imx415_i2c7: camera-1@1a {
				compatible = "sony,imx415";
				reg = <0x1a>;
				clocks = <&clk37m125>;
				clock-names = "inck";
				power-domains = <&power RK3568_PD_VI>;
				avdd-supply = <&vcc_cam0>;
				dvdd-supply = <&vcc_cam0>;
				ovdd-supply = <&vcc_cam0>;
				status = "disabled";

				port {
					imx415_i2c7_out: endpoint {
						data-lanes = <1 2>;
						remote-endpoint = <&imx415_i2c7_in>;
						link-frequencies = /bits/ 64 <445500000>;
					};
				};
			};
		};

		i2c8: i2c@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c9: i2c@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

&i2s0_8ch {
	/* HDMI Sound */
	status = "okay";
};

&i2s1_8ch {
	/* I2S Sound */
	pinctrl-0 = <
		&i2s1_pins
		&i2s1m1_sdo0		/* I2S1_SDO0 */
		&i2s1m1_sdi0		/* I2S1_SDI0 */
	>;
	rockchip,trcm-sync-tx-only;
	status = "okay";
};

&isp {
	status = "okay";
};

&isp_mmu {
	status = "okay";
};

&isp_vir0 {
	status = "okay";
};

&mdio0 {
	rgmii_phy0: phy@0 {
		/* RTL8211F */
		pinctrl-names = "default";
		pinctrl-0 = <&gmac0_rst_pins>;
		compatible = "ethernet-phy-id001c.c916";
		reg = <0x0>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio2 RK_PD3 GPIO_ACTIVE_LOW>;
	};
};

&mdio1 {
	rgmii_phy1: phy@0 {
		/* RTL8211F */
		pinctrl-names = "default";
		pinctrl-0 = <&gmac1_rst_pins>;
		compatible = "ethernet-phy-id001c.c916";
		reg = <0x0>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_LOW>;
	};
};

&pcie2x1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie20_pins>;
	reset-gpios = <&gpio1 RK_PB1 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie20>;
	supports-clkreq;
	status = "okay";
};

&pcie30phy {
	data-lanes = <1 1>;
	phy-supply = <&vcc3v3_pcie30>;
	status = "okay";
};

&pcie3x2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30_pins>;
	reset-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie30>;
	supports-clkreq;
	status = "okay";
};

&pwm5 {
	status = "okay";
};

&rga {
	status = "okay";
};

&sdmmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	bus-width = <4>;
	disable-wp;
	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&vcc3v3_sys>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1m1_pins_hs &spi1m1_cs0_hs>;
	num-cs = <1>;
	status = "okay";

	spi@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <20000000>;
	};
};

&spi2 {
	pinctrl-0 = <&spi2m1_pins_hs &spi2m1_cs0_hs &spi2m1_cs1_hs>;
	num-cs = <2>;
	status = "okay";

	spi@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <20000000>;
	};

	spi@1 {
		compatible = "rohm,dh2228fv";
		reg = <1>;
		spi-max-frequency = <20000000>;
	};
};

&uart3 {
	pinctrl-0 = <&uart3m1_xfer &uart3m0_ctsn &uart3m0_rtsn>;
	status = "okay";
};

&uart7 {
	pinctrl-0 = <&uart7m1_xfer &uart7m0_ctsn &uart7m0_rtsn>;
	status = "okay";
};

&uart8 {
	pinctrl-0 = <&uart8m0_xfer &uart8m0_ctsn &uart8m0_rtsn>;
	status = "okay";
};

&uart9 {
	pinctrl-0 = <&uart9m1_xfer>;
	status = "okay";
};

&usb_host0_xhci {
	usb-role-switch;
	role-switch-default-mode = "peripheral";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			/* HS */
			reg = <0>;

			usb_host0_xhci_hs: endpoint {
				remote-endpoint = <&typec_hs>;
			};
		};

		port@1 {
			/* SS */
			reg = <1>;

			usb_host0_xhci_ss: endpoint {
				remote-endpoint = <&typec_ss>;
			};
		};

		port@2 {
			/* Role Switch */
			reg = <2>;

			usb_host0_xhci_role_sw: endpoint {
				remote-endpoint = <&fusb_role_sw>;
			};
		};
	};
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_xhci {
	status = "okay";
};

&usb2phy0_host {
	phy-supply = <&vcc5v0_usb3_host1>;
	status = "okay";
};

&usb2phy1_host {
	status = "okay";
};

&vpu {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&vepu {
	status = "okay";
};

&vepu_mmu {
	status = "okay";
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vp0 {
	vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
		remote-endpoint = <&hdmi_in_vp0>;
	};
};

&vp1 {
	vp1_out_dsi0: endpoint@ROCKCHIP_VOP2_EP_MIPI0 {
		reg = <ROCKCHIP_VOP2_EP_MIPI0>;
		remote-endpoint = <&dsi0_in_vp1>;
	};
};

&vp2 {
	status = "disabled";

	vp2_out_lvds: endpoint@ROCKCHIP_VOP2_EP_LVDS0 {
		reg = <ROCKCHIP_VOP2_EP_LVDS0>;
		remote-endpoint = <&lvds_in_vp2>;
	};
};

&pinctrl {
	pinctrl-names = "default";
	pinctrl-0 = <&board_pins>;

	board {
		board_pins: board-pins {
			rockchip,pins =
				<1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>,		/* GPIO_0 */
				<1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,		/* GPIO_1 */
				<1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>,		/* GPIO_2 */
				<1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;		/* GPIO_3 */
		};
	};

	csi {
		csi0_pwr: csi0-pwr-pins {
			rockchip,pins =
				<2 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>;		/* CSI_PWREN0 */
		};

		csi0_rst: csi0-rst-pins {
			rockchip,pins =
				<3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;		/* CSI_RESET0# */
		};
	};

	dsi {
		dsi_pins: dsi-pins {
			rockchip,pins =
				<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,		/* DSI_PWREN */
				<0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;		/* DSI_RESET# */
		};
	};

	i2s {
		i2s1_pins: i2s1-pins {
			rockchip,pins =
				<3 RK_PC6 4 &pcfg_pull_none_smt>,		/* I2S1_MCLK */
				<3 RK_PC7 4 &pcfg_pull_none_smt>,		/* I2S1_TX_SCLK */
				<3 RK_PD0 4 &pcfg_pull_none_smt>;		/* I2S1_TX_LRCK */
		};
	};

	lvds {
		lvds_pins: lvds-pins {
			rockchip,pins =
				<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;		/* LVDS_PWREN */
		};
	};

	net {
		gmac0_rst_pins: gmac0-rst-pins {
			rockchip,pins =
				<2 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;	/* GMAC0_RST */
		};

		gmac1_rst_pins: gmac1-rst-pins {
			rockchip,pins =
				<4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;	/* GMAC1_RST */
		};
	};

	pcie20 {
		pcie20_pins: pcie20-pins {
			rockchip,pins =
				<2 RK_PD0 4 &pcfg_pull_none>,			/* PCIE20_CLKREQn_M1 */
				<2 RK_PD1 4 &pcfg_pull_none>,			/* PCIE20_WAKEn_M1 */
				<1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;	/* PCIE20_PERST */
		};
	};

	pcie30 {
		pcie30_pins: pcie30-pins {
			rockchip,pins =
				<4 RK_PC2 4 &pcfg_pull_none>,			/* PCIE30X2_CLKREQn_M2 */
				<4 RK_PC3 4 &pcfg_pull_none>,			/* PCIE30X2_WAKEn_M2 */
				<4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;		/* PCIE30X2_PERSTn_M2 */
		};

		pcie30_oe_pins: pcie30-oe-pins {
			rockchip,pins =
				<3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;	/* PCIECLKIC_OE */
		};

		pcie30_pwr_pins: pcie30-pwr-pins {
			rockchip,pins =
				<3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;	/* PCIE30_PWREN */
		};
	};

	usbmux {
		usbmux_pins: usbmux-pins {
			rockchip,pins =
				<4 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,		/* USB3_OTG0_SEL */
				<3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;	/* Unused */
		};
	};
};
